# /etc/sbc-quartz/mgmt.env — read by compose.yaml, etcd-snapshot and the install script.
# Same file on any management node; only the paths differ.

# Fast local storage for registry caches and holzkube-manager data.
#   Pi Zero 2 W : a USB disk, e.g. /mnt/usb
#   Quartz64 A  : the eMMC root, /var/lib/sbc-quartz
DATA_DIR=/var/lib/sbc-quartz

# Where etcd snapshots go. Keep it off the control plane.
#   Pi Zero 2 W : /mnt/usb/etcd
#   Quartz64 A  : the microSD if fitted (/mnt/sd/etcd), else /var/lib/sbc-quartz/etcd
BACKUP_DIR=/var/lib/sbc-quartz/etcd
BACKUP_KEEP=28

# Talos control plane node to snapshot etcd from
CONTROL_PLANE=10.20.0.10
TALOSCONFIG=/etc/sbc-quartz/talosconfig

# Cached registry blobs expire after this (registry:2 proxy TTL) to bound disk use
REGISTRY_TTL=168h
