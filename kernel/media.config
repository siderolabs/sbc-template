# "media" kernel flavor: mainline V4L2 stateless video blocks on RK356x.
# Appended to siderolabs/pkgs kernel/build/config-arm64, then `make olddefconfig`.
#   rk3568-vpu  (Hantro G1)   -> H.264 / VP8 / MPEG-2 decode   (/dev/video*, /dev/media*)
#   rk3568-vepu (Hantro VEPU) -> JPEG encode
#   rk3568-rga  (RGA2)        -> scale / colour-convert
# Mainline has no rkvdec node for RK356x and no H.264 encode; VDEC is enabled
# for future kernels and harmless today.
CONFIG_VIDEO_HANTRO=m
CONFIG_VIDEO_HANTRO_ROCKCHIP=y
CONFIG_VIDEO_ROCKCHIP_RGA=m
CONFIG_VIDEO_ROCKCHIP_VDEC=m
